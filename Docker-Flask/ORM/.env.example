# Archivo de variables de entorno para Flask Backend
# Copia este archivo como .env y ajusta los valores según sea necesario

# Clave secreta para firmar tokens JWT (Cambiar en producción)
SECRET_KEY=super_secret_jwt_key_escom_practica_2_2026

# Puerto de la aplicación Flask
PORT=5000

# Entorno de Flask
FLASK_ENV=development
FLASK_DEBUG=True

# ---------------------------------------------------------------
# Base de Datos (Soporte Híbrido: SQLite o PostgreSQL 17)
# ---------------------------------------------------------------
# Opción 1: SQLite local (predeterminado para ejecución rápida sin dependencias externas)
DATABASE_URL=sqlite:///site.db

# Opción 2: PostgreSQL 17 (en Docker Compose con servicio postgres)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres

# Opción 3: PostgreSQL 17 (ejecución en la máquina host con puerto publicado)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
